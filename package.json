{
  "name": "mediaforge",
  "version": "1.0.0",
  "private": true,
  "description": "MediaForge — conversor de ficheiros e downloader multimédia tudo-em-um.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "setup": "node scripts/setup.mjs",
    "setup:ytdlp": "node scripts/fetch-ytdlp.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
